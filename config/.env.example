# ============================================================
# Claudiao 电台 · 环境变量模板
# 用法: Copy-Item config\.env.example config\.env  然后编辑 config\.env
# 注意: config\.env 已被 .gitignore 忽略，不要提交
# ============================================================

# ---------- 服务 ----------
# 监听地址。默认只允许本机访问。
# 想让手机连上，改成 0.0.0.0 —— 但必须同时设置 RADIO_AUTH_TOKEN
HOST=127.0.0.1
PORT=8080
NODE_ENV=development

# 访问令牌。任何非 127.0.0.1 访问都必须带此令牌。
# 生成方式: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 留空 = 不校验（仅当 HOST=127.0.0.1 时允许留空）
RADIO_AUTH_TOKEN=

# ---------- 大脑 (BRAIN = ZCode Agent) ----------
# 大脑复用 ZCode 桌面端的 bigmodel 编码计划账号态，零额外 API 成本。
# 前提: ZCode 桌面端已安装并登录过（凭据与 provider 缓存在 ~/.zcode/v2/）。
# 适配器: src/adapters/brain/zcode-agent.js
# ⚠️ 变量名前缀 CLAUDIAO_ 是刻意的：与 ZCode 自身注入的环境变量隔离。

# ZCode CLI 入口（桌面端自带）。默认值即标准安装路径，一般不用改。
CLAUDIAO_ZCODE_CLI=E:\Program Files\ZCode\resources\glm\zcode.cjs
esources\glm\zcode.cjs
esources\glm\zcode.cjs

# 账号 provider 与模型
CLAUDIAO_ZCODE_PROVIDER=account:bigmodel-individual-coding-plan
CLAUDIAO_ZCODE_MODEL=GLM-5.3-Flash

# 推理档位: low | high | max
# 实测（15K prompt 单轮端到端）: low ≈ 12~20s（默认，质量达标）；high/max 40~55s+
CLAUDIAO_ZCODE_REASONING=low

# 大脑子进程的工作目录。必须固定为项目根（语料相对路径与会话目录都依赖它）。
CLAUDIAO_ZCODE_CWD=D:\DJ

# 编码计划 API key。留空 = 自动从共享凭据解密（推荐）。
# 仅当电台以其他 Windows 账户运行时才需要手动填写。
CLAUDIAO_ZCODE_API_KEY=

# 单次大脑调用超时（毫秒）。Agent 实测 low 档 12~20s，60s 余量约 3 倍。
BRAIN_TIMEOUT_MS=60000

# 失败重试次数（0 = 不重试）。超时或协议错误时触发。
BRAIN_RETRY=1

# 并发上限。保持 1 —— app-server 的会话是串行的，并发触发会排队。
BRAIN_MAX_CONCURRENCY=1

# 是否把完整 prompt 写进日志。默认 0 以保护隐私（语料与对话内容会被记录）。
LOG_PROMPT=0

# ---------- 音乐 (MUSIC) ----------
# 公共 API 实例。实测 search/url/lyric/pic/playlist 全部可用。
MUSIC_BASE_URL=https://music-api.gdstudio.xyz/api.php

# 音源降级链。
# ⚠️ 实测结论（不要凭直觉调整顺序）：
#   netease —— search ✅ / song_url ✅（返回可播放直链）/ lyric ⚠️偶发无时间戳
#              / pic ✅ / playlist ✅
#   joox    —— search ✅ / lyric ✅ / pic ✅ / playlist ✅
#              / song_url ❌ 不返回可播放直链
#   因此 **song_url 只能靠 netease** —— 它是播放链路的唯一硬依赖。
#   joox 的价值是元数据/歌词的二级来源，不是播放来源。
#   kuwo / tencent / migu / kugou —— 实测 400/503，默认不启用。
MUSIC_SOURCES=netease,joox

# ⚠️ 请求节流下限（毫秒）。这是**必需**的，不是优化。
# 实测该公共实例对突发请求会返回 503，冷却/退避后恢复
# （同一 URL 连续三次请求的结果可能是 200/503/503）。
# 因此所有音乐请求必须串行并保持最小间隔。
MUSIC_MIN_INTERVAL_MS=1200

# 瞬态错误（5xx / 429）的退避重试次数与基数
MUSIC_RETRY_MAX=4
MUSIC_RETRY_BACKOFF_MS=1200

# 默认码率
MUSIC_BITRATE=320

# 直链缓存 TTL（秒）。直链是临时 CDN URL，有时效，不宜过长。
MUSIC_URL_TTL_SEC=600

# 检索结果缓存 TTL（秒）
MUSIC_SEARCH_TTL_SEC=1800

# 单次解析最多并发请求数。**必须为 1**（配合 MUSIC_MIN_INTERVAL_MS 串行化）。
# 实测把并发提到 3 会立刻触发 503 —— 该实例对突发请求没有容忍度。
MUSIC_RESOLVE_CONCURRENCY=1

# 本地兜底音频目录（所有源都失败时播放）
FALLBACK_AUDIO_DIR=data/fallback-audio

# ---------- 语音 (TTS) ----------
# 首选引擎: edge | sapi   （edge 音质好需联网，sapi 完全离线音质一般）
TTS_ENGINE=edge

# edge-tts 可执行文件。已实测安装于 D:\python\Scripts\edge-tts.exe
CLAUDIAO_EDGE_TTS_BIN=D:\python\Scripts\edge-tts.exe

# 音色。实测可用中文音色：
#   zh-CN-XiaoxiaoNeural  女 / 温暖     <- 电台默认，最耐听
#   zh-CN-XiaoyiNeural    女 / 活泼
#   zh-CN-YunjianNeural   男 / 激情
#   zh-CN-YunxiNeural     男 / 阳光活泼
#   zh-CN-YunxiaNeural    男 / 可爱
#   zh-CN-YunyangNeural   男 / 专业可靠  <- 新闻播报感
#   zh-CN-liaoning-XiaobeiNeural  女 / 东北方言
#   zh-CN-shaanxi-XiaoniNeural    女 / 陕西方言
TTS_VOICE=zh-CN-XiaoxiaoNeural

# 语速调整（edge-tts 语法: +10% / -10%）
TTS_RATE=+0%

# 音量调整
TTS_VOLUME=+0%

# 音调调整
TTS_PITCH=+0Hz

# 缓存目录与上限
TTS_CACHE_DIR=data/tts-cache
TTS_CACHE_MAX_FILES=2000
TTS_CACHE_MAX_BYTES=524288000

# 合成并发上限（过高会被 edge-tts 服务端限流）
TTS_CONCURRENCY=2

# 合成超时（毫秒）
TTS_TIMEOUT_MS=15000

# 连续失败多少次后熔断到 SAPI 兜底
TTS_BREAKER_THRESHOLD=3

# SAPI 兜底音色。实测此机器唯一中文音色。
SAPI_VOICE=Microsoft Huihui Desktop

# 是否启用 SAPI 兜底（0 = 合成失败就跳过语音直接放歌）
TTS_FALLBACK_ENABLED=1

# ---------- 环境注入 (VOICE · I/O) ----------
# 天气。留空则不做天气注入（播报里不会提天气）。
# 推荐用和风天气 / OpenWeatherMap 的免费额度
WEATHER_PROVIDER=openweathermap
WEATHER_API_KEY=
WEATHER_CITY=Beijing
WEATHER_CITY_ID=
WEATHER_TIMEOUT_MS=5000

# 时区。影响所有时段判断与 cron。
TZ=Asia/Shanghai

# ---------- 状态 ----------
DB_PATH=data/radio.db

# ---------- 外部通知 (可选) ----------
# 飞书自定义机器人 Webhook。留空则不发通知。
# 用途: 电台启动/崩溃、大脑连续失败、每日总结推送
FEISHU_WEBHOOK=
# 飞书机器人签名密钥（若启用了签名校验）
FEISHU_SECRET=

# ---------- 投送 (可选，P2) ----------
# 是否启用 UPnP/DLNA 投送
UPNP_ENABLED=0
# 目标设备名（留空则自动发现第一个可用的）
UPNP_DEVICE=

# ---------- 日志 ----------
LOG_LEVEL=info
LOG_DIR=data/logs
LOG_MAX_FILES=14
